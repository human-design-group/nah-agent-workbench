{
  "name": "agento",
  "displayName": "Agento — Agent Workbench",
  "description": "Unified Multi-Agent Mission Control & Responsive Grid for Cursor and VS Code",
  "version": "0.1.0",
  "publisher": "human-design-group",
  "icon": "media/agento-logo.png",
  "author": {
    "name": "Human Design Group",
    "url": "https://thehumandesigngroup.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/human-design-group/nah-agent-workbench.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "agento",
    "agent",
    "multi-agent",
    "workbench",
    "cursor",
    "notahuman",
    "antigravity",
    "openclaw",
    "opencode",
    "hermes"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:agento.open",
    "onCommand:agento.resetLayout"
  ],
  "contributes": {
    "commands": [
      {
        "command": "agento.open",
        "title": "Open Agent Workbench",
        "category": "Agento",
        "icon": "$(layout-grid)"
      },
      {
        "command": "agento.resetLayout",
        "title": "Reset Workbench Layout",
        "category": "Agento"
      }
    ],
    "keybindings": [
      {
        "command": "agento.open",
        "key": "cmd+alt+n",
        "mac": "cmd+alt+n",
        "win": "ctrl+alt+n",
        "linux": "ctrl+alt+n"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "agento.open"
        },
        {
          "command": "agento.resetLayout"
        }
      ]
    },
    "configuration": {
      "title": "Agent Workbench",
      "properties": {
        "agentWorkbench.defaultLayout": {
          "type": "string",
          "enum": [
            "vertical",
            "horizontal",
            "grid",
            "split-3",
            "focus"
          ],
          "default": "vertical",
          "description": "Default multi-agent layout mode"
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "package": "node build.mjs && npx @vscode/vsce package --no-dependencies -o dist/agento-0.1.0.vsix",
    "install-ext": "npm run package && cursor --install-extension dist/agento-0.1.0.vsix --force"
  },
  "dependencies": {
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^2.1.7",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.18.1",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  }
}
